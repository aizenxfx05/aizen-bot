# API URL for the dashboard backend (points to your bot's FastAPI server or Cloudflare tunnel)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API Key for authentication (must match DASHBOARD_API_KEY in bot/.env)
NEXT_PUBLIC_DASHBOARD_API_KEY=AIZEN_XFX_SECURE_API_KEY_CHANGE_THIS_NOW

# NextAuth Configuration
NEXTAUTH_URL=https://aizenxfx.in
NEXT_PUBLIC_SITE_URL=https://aizenxfx.in
NEXTAUTH_SECRET=aizen_xfx_nextauth_secret_string_2026_super_secure

# Discord OAuth configuration (get from Discord Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Admin User IDs (comma separated Discord user IDs)
NEXT_PUBLIC_ADMIN_IDS=1232698871797256263

# Customizable Brand / Bot name shown across the dashboard
NEXT_PUBLIC_BRAND_NAME="Aizen XFX"
NEXT_PUBLIC_BRAND_NAME_WORD="AX"